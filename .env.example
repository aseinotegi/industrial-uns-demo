# Copy to .env (git ignores it) and fill in. docker compose reads it on its own.

# Gemini reads the robot's photos in the cloud: nothing to install on the PC.
# Free key: https://aistudio.google.com/apikey
INSPECTOR_CONFIG=inspector.gemini.yaml
GEMINI_API_KEY=
# Optional: another Gemini model (see config/inspector.gemini.yaml).
# POI_PROVIDER_MODEL=gemini-3.5-flash-lite

# A photo older than this, queue included, is discarded as stale.
# MAX_PHOTO_AGE_S=45

# Passwords: demo ones if left out, fine on your own computer. Anywhere else, set them
# all (e.g. each one from: openssl rand -hex 24).
# MQTT_PASSWORD_PLC_GATEWAY=   MQTT_PASSWORD_ROBOT=     MQTT_PASSWORD_INSPECTOR=
# MQTT_PASSWORD_RULES=         MQTT_PASSWORD_HISTORIAN= MQTT_PASSWORD_SIMULADOR=
# MQTT_PASSWORD_CONSOLE=       MQTT_PASSWORD_TREE=      MQTT_PASSWORD_EXPLORER=
# DB_PASSWORD=                 GRAFANA_DB_PASSWORD=     GRAFANA_ADMIN_PASSWORD=

# The public demo (see docker-compose.publico.yml): all the passwords above, plus
# COMPOSE_FILE=docker-compose.yml:docker-compose.publico.yml
# TUNNEL_TOKEN=
# GRAFANA_URL=https://demo-grafana.example.com
# Visitors' photos (read by Gemini): per visitor and hour, overall per hour and per day.
# TRIALS_PER_VISITOR_HOUR=5
# TRIALS_PER_HOUR=30
# TRIALS_PER_DAY=200
